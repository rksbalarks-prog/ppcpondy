<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- API calls, property photos/videos and OpenStreetMap tiles. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Listing photos/videos are chosen through the Android photo picker
         (image_picker's usePhotoPicker path, enabled in main.dart), which
         hands back per-item URIs and needs NO storage permission at all.
         READ_MEDIA_IMAGES / READ_MEDIA_VIDEO / READ_EXTERNAL_STORAGE were
         declared here but never actually used, and Google Play rejected
         version code 36 for them under the Photo and Video Permissions
         policy. CAMERA went the same way — nothing calls ImageSource.camera,
         and declaring it makes Play imply android.hardware.camera. Do not
         re-add any of them without a code path that genuinely needs it. -->
    <!-- AI assistant: hands-free voice capture (record -> /transcribe). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- FCM push notifications. POST_NOTIFICATIONS is runtime-requested on
         Android 13+ by PushService (firebase_messaging requestPermission). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="Pondy Property"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Default channel + icon FCM uses for notification-type messages
             delivered while the app is backgrounded/terminated. The channel id
             must match PushService._channel and ANDROID_CHANNEL in
             PPC/fcm/sendPush.js. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="ppcpondy_default" />
        <!-- Android renders a notification's SMALL icon as an ALPHA MASK:
             every non-transparent pixel is repainted solid white, and the
             colour below tints the result. @mipmap/ic_launcher is a fully
             opaque square, so it arrived as a featureless white block. This
             drawable is the PPC key glyph on a transparent field, which is
             what that mask actually needs. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_ppc" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/ppc_notification_accent" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Package visibility (Android 11+) for the intents the app launches:
         tel:, mailto:, https: (WhatsApp / Play Store / Maps) and the share sheet. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
